        <Shortcut Id="DesktopShortcut" Directory="DesktopFolder" Name="FMS UPDATE MANAGER Beta" Description="FMS UPDATE MANAGER Beta" Icon="AppIcon" WorkingDirectory="INSTALLFOLDER" Target="[INSTALLFOLDER]FMS_UPDATE_MANAGER.exe" />
        <RegistryValue Root="HKLM" Key="Software\CNRPG\FMS UPDATE MANAGER Beta" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="D:\HugoMoveData\User\16832\Desktop\FMS UPDATE MANAGER\dist_test\FMS_UPDATE_MANAGER\**" />
    </ComponentGroup>
  </Fragment>
